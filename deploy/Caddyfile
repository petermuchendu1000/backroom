# Ongero — TLS termination and reverse proxy.
#
# Mounted read-only by the caddy service in docker-compose.prod.yml. Caddy obtains and
# renews Let's Encrypt certificates by itself; it needs ports 80 and 443 on the public
# interface and DNS already pointing at this host. Certificates and the ACME account key
# live in the caddy_data volume — do not delete that volume casually, or every restart
# re-requests certificates and Let's Encrypt rate-limits the domain.
#
# Hostnames come from the environment ({$API_HOST}, {$WS_HOST}, {$ACME_EMAIL}), set in
# .env and passed through by the compose file.
{
	# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
	email {$ACME_EMAIL}
}

# =====================================================================
# api.ongero.com — the REST API
# =====================================================================
{$API_HOST} {
	encode zstd gzip

	# Swagger. main.ts calls SwaggerModule.setup('docs', ...), which does NOT inherit
	# the api/v1 global prefix, so the interactive docs sit at the root — and they
	# describe every endpoint, parameter and DTO on the service. That is a map of the
	# API handed to anyone who asks. Blocked here rather than in code so the docs stay
	# available in development, where they are useful.
	handle /docs* {
		respond 404
	}

	# Everything the app actually calls lives under the api/v1 prefix:
	#   /api/v1/auth/*           /api/v1/payments/*
	#   /api/v1/health           /api/v1/payments/palpluss/webhook
	#   /api/v1/subscriptions/*  /api/v1/mpesa/*
	handle {
		reverse_proxy rest-api:8080 {
			# NestJS sees the real client address instead of Caddy's, so rate
			# limiting and abuse logging are not all attributed to one IP.
			header_up X-Real-IP {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Do not advertise the proxy or its version.
		-Server
	}

	log {
		output file /data/access-api.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# =====================================================================
# ws.ongero.com — the WebSocket signalling service
# =====================================================================
# Caddy upgrades WebSocket connections through reverse_proxy without extra configuration;
# there is no Connection/Upgrade header dance to write out as there is with nginx.
{$WS_HOST} {
	handle /ws* {
		reverse_proxy ws-signaling:8443 {
			header_up X-Real-IP {remote_host}
			# Signalling connections are long-lived and mostly idle between
			# messages. The default would close them.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle /health* {
		reverse_proxy ws-signaling:8443
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access-ws.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# =====================================================================
# turn.ongero.com — certificate only, nothing served
# =====================================================================
# This block exists so that Caddy obtains and renews a certificate for the TURN
# hostname. coturn needs one to serve TURNS on 5349, cannot obtain its own, and
# has no ACME client; running a second ACME client beside Caddy would mean two
# things competing for port 80.
#
# The cert-sync service copies the resulting pair into a volume coturn can read.
# Caddy writes certificates root-owned mode 600 and coturn runs as nobody, so
# that copy is not optional — see deploy/cert-sync.sh.
#
# Nothing is served on this hostname over HTTPS. If something ever should be,
# put it here; the certificate is already in hand.
{$TURN_HOST} {
	handle {
		respond 404
	}

	header -Server

	log {
		output file /data/access-turn.log {
			roll_size 2MiB
			roll_keep 2
		}
	}
}

# =====================================================================
# dl.ongero.com — the APK download
# =====================================================================
# The website is a static export on Cloudflare Pages, which caps a single file at
# 25 MiB. A release APK is larger than that, so the download is served from here
# instead, where there is no such limit and Caddy already terminates TLS.
#
# BEFORE DEPLOYING THIS: the A record for {$DOWNLOAD_HOST} must already point at this
# host, grey-clouded like the others. Caddy obtains certificates per hostname, so a
# missing record does not affect api/ws/turn — but it will retry ACME for this name
# and Let's Encrypt rate-limits repeated failures per domain.
{$DOWNLOAD_HOST} {
	root * /srv/downloads

	# No `browse`: file_server answers 404 for a directory rather than listing it,
	# so the contents of /srv/downloads are not enumerable.
	#
	# No explicit Content-Type for .apk either. That was here, on the assumption that
	# Caddy would otherwise serve octet-stream — which some Android browsers refuse to
	# hand to the package installer. Removing it changed nothing: the official image
	# installs the `mailcap` package, whose /etc/mime.types maps apk to
	# application/vnd.android.package-archive, and Go's mime package reads it. The
	# directive was doing no work, so it is gone. deploy/verify.sh section 10 asserts
	# the served Content-Type, which is what would catch this if the image ever stopped
	# shipping mailcap.
	file_server

	# Deliberately no `encode`: an APK is a ZIP, so compressing it again spends CPU
	# on every download to save nothing.

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/access-dl.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
