# Ongero production environment — copy to .env in the repository root.
#
#     cp deploy/env.example .env && chmod 600 .env
#
# .env is in .gitignore. Keep it that way. Every value below marked REQUIRED has no
# default: compose refuses to start without it and tells you which one is missing,
# rather than silently falling back to a development value.
#
# Generate each secret on the server, not on a laptop, and never reuse one you have
# pasted into a chat window, an issue or a terminal you do not control.

# ---------------------------------------------------------------------------
# Database                                                         REQUIRED
# ---------------------------------------------------------------------------
# NOTE: these are read when Postgres FIRST initialises its data directory.
# Changing POSTGRES_PASSWORD later does NOT change the password of an existing
# database — see "Changing the database password" in docs/10_PRODUCTION_DEPLOYMENT.md.
POSTGRES_USER=ongero
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=ongero

# Leave unset for the bundled postgres container: the official image ships ssl=off
# and it is reachable only on the compose network and on 127.0.0.1. Set to true only
# when POSTGRES_HOST points at a managed database that requires TLS.
# POSTGRES_SSL=true

# ---------------------------------------------------------------------------
# Auth                                                             REQUIRED
# ---------------------------------------------------------------------------
# Shared by rest-api and ws-signaling. If these two ever disagree, every
# WebSocket connection fails with 401 while the REST API keeps working — the
# exact symptom is a client that logs in fine and then cannot connect to a call.
JWT_SECRET=                 # openssl rand -hex 48
JWT_EXPIRES_IN=15m

# ---------------------------------------------------------------------------
# TURN                                                             REQUIRED
# ---------------------------------------------------------------------------
# ONE value shared by three components: coturn, rest-api and ws-signaling. All
# three compute the same HMAC; a mismatch means coturn rejects every allocation
# and calls connect only when both parties are on networks that allow a direct
# peer-to-peer path. .github/scripts/assert_shared_turn_secret.py guards this.
TURN_STATIC_AUTH_SECRET=    # openssl rand -hex 32
TURN_CREDENTIAL_TTL=3600

# The server's own public IPv4. coturn advertises this address to clients as the
# relay candidate; if it is wrong, media is relayed to nowhere.
PUBLIC_IP=95.179.194.39

# Public hostnames. These are handed to phones, so they must resolve on the
# public internet — not Docker service names.
TURN_HOST=turn.ongero.com
TURN_REALM=ongero.com
API_HOST=api.ongero.com
WS_HOST=ws.ongero.com

# Serves the Android APK (see docs/11_RELEASE_AND_DISTRIBUTION.md). Its A record must
# point at PUBLIC_IP, grey-clouded, BEFORE the stack is restarted with this set —
# Caddy will otherwise fail ACME for this name repeatedly and get rate-limited.
DOWNLOAD_HOST=dl.ongero.com

# ---------------------------------------------------------------------------
# TLS                                                              REQUIRED
# ---------------------------------------------------------------------------
# Where Let's Encrypt sends warnings if renewal stops working. Use an address
# somebody actually reads; a silently expired certificate takes the API down.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Payments — PalPluss                                              REQUIRED
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=palpluss
PALPLUSS_BASE_URL=https://api.palpluss.com/v1

# pp_live_… or pp_test_…  Test keys hit the SAME URL and move simulated money.
PALPLUSS_API_KEY=

# Must match, exactly, what you register in the PalPluss console. This is the
# default compiled into the service, so changing it here means changing it there.
PALPLUSS_CALLBACK_URL=https://api.ongero.com/api/v1/payments/palpluss/webhook

# whsec_… from the PalPluss console, under Webhooks, AFTER adding the callback
# domain. Leave empty and callbacks are accepted with NO signature check —
# PalPluss delivers to unregistered domains, just unsigned. The service logs a
# warning at boot when this is unset. Set it.
PALPLUSS_WEBHOOK_SECRET=

# Optional: route the STK prompt through one specific shortcode.
PALPLUSS_CHANNEL_ID=

# Prices in KES.
SUBSCRIPTION_MONTHLY_PRICE=500
SUBSCRIPTION_YEARLY_PRICE=5000

# ---------------------------------------------------------------------------
# Push notifications                                               REQUIRED
# ---------------------------------------------------------------------------
# The JSON key file goes at ./secrets/firebase-service-account.json (mode 600).
# Without it a listener's phone never rings for an incoming call.
#
# Read by BOTH rest-api and ws-signaling, and it must be the project id string from the
# Firebase console (e.g. ongero-prod), not the numeric project number — ws-signaling
# interpolates it straight into https://fcm.googleapis.com/v1/projects/<id>/messages:send,
# and the service account key must belong to that same project or every push is 403.
# The push that actually wakes a listener's phone is sent by ws-signaling, not rest-api.
FCM_PROJECT_ID=

# ---------------------------------------------------------------------------
# Website origin for CORS
# ---------------------------------------------------------------------------
CORS_ORIGIN=https://ongero.com
