# Ongero — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# DATABASE (Postgres)
# ============================================
POSTGRES_USER=backroom
POSTGRES_PASSWORD=backroom_dev_password
POSTGRES_DB=backroom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection URL (used by backend services)
DATABASE_URL=postgres://backroom:backroom_dev_password@localhost:5432/backroom

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ============================================
# JWT / AUTH
# ============================================
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_a_32_byte_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# TURN / STUN (coturn)
# ============================================
TURN_URL=turn:localhost:3478
STUN_URL=stun:localhost:3478
# No static username or password any more. coturn runs in use-auth-secret mode and
# every credential is minted per call, expires on its own, and carries the account id.
# For REST API credential generation:
# coturn's static-auth-secret. ONE value, shared by coturn, the REST API and the
# signalling service — all three compute the same HMAC, so any mismatch means every
# relayed call fails with no useful error anywhere.
# REQUIRED: docker compose refuses to start without it. Generate with:
#     openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=
# How long a minted credential stays valid, in seconds.
TURN_CREDENTIAL_TTL=3600

# ============================================
# FIREBASE / FCM (Push Notifications)
# ============================================
# Download service account from Firebase Console > Project Settings > Service Accounts
# Place the JSON file at: backend/rest-api/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FCM_PROJECT_ID=your-firebase-project-id

# ============================================
# PAYMENT GATEWAY
# ============================================
# Which gateway takes the money. 'palpluss' (default) or 'daraja' for a direct
# Safaricom integration. The person paying sees the same M-Pesa prompt either way.
PAYMENTS_PROVIDER=palpluss

# ============================================
# PALPLUSS (https://docs.palpluss.com)
# ============================================
# An aggregator in front of Daraja: no OAuth dance, no passkey, and — the part that
# matters — it SIGNS its callbacks, which Daraja does not.
# Create a key at https://console.palpluss.com under API Keys. pp_test_… keys move
# simulated money against the same URL as live ones.
PALPLUSS_API_KEY=CHANGE_ME_pp_test_your_key
# Must be a public HTTPS URL. PalPluss cannot reach localhost or a private address;
# use ngrok in development.
PALPLUSS_CALLBACK_URL=https://api.ongero.com/api/v1/payments/palpluss/webhook
# Optional. Routes the prompt through one specific shortcode instead of the account
# default. Leave blank unless you have more than one channel.
PALPLUSS_CHANNEL_ID=
# Add the callback URL's DOMAIN under Webhooks in the console, then paste the whsec_
# secret it gives you here. Leave this blank and callbacks are accepted WITHOUT a
# signature check: PalPluss still delivers to unregistered domains, just unsigned, so
# anyone who learns the URL can POST a fake "payment succeeded" at it. The amount and
# correlation checks still apply, but this is the cheap defence — set it.
PALPLUSS_WEBHOOK_SECRET=

# ============================================
# M-PESA (Safaricom Daraja API)
# ============================================
# Only needed when PAYMENTS_PROVIDER=daraja, or to keep the legacy /mpesa routes alive.
# Get credentials from https://developer.safaricom.co.ke/
MPESA_ENVIRONMENT=sandbox
# Options: sandbox, production

# Consumer Key and Secret from Daraja portal
MPESA_CONSUMER_KEY=CHANGE_ME_your_consumer_key
MPESA_CONSUMER_SECRET=CHANGE_ME_your_consumer_secret

# Your Paybill or Till Number
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online Passkey (from Daraja)
MPESA_PASSKEY=CHANGE_ME_your_passkey

# Callback URLs (must be HTTPS and publicly accessible)
# Use ngrok for local development: ngrok http 8080
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/mpesa/callback
MPESA_TIMEOUT_URL=https://your-domain.com/api/v1/mpesa/timeout
MPESA_RESULT_URL=https://your-domain.com/api/v1/mpesa/result

# Subscription Pricing (in KES)
SUBSCRIPTION_MONTHLY_PRICE=500
SUBSCRIPTION_YEARLY_PRICE=5000
SUBSCRIPTION_TRIAL_DAYS=7

# ============================================
# APP CONFIG
# ============================================
NODE_ENV=development
PORT=8080
WS_PORT=8443
LOG_LEVEL=debug

# ============================================
# OBSERVABILITY (optional for dev)
# ============================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

