# Release signing. The keystore IS the app's identity: anyone holding it can ship an
# update that Android accepts as genuine. It is backed up outside the repository, and
# keystore.properties holds its passwords.
*.jks
*.keystore
keystore.properties

# Published APKs are build output, served from the server, not stored in git.
downloads/*.apk

